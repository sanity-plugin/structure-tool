{
  "name": "sanity-plugin-structure-tool",
  "version": "0.3.0",
  "description": "A JSON based powerful structure tool for Sanity Studio",
  "keywords": [
    "structure",
    "structure tool",
    "structure builder",
    "sanity structure",
    "sanity structure tool",
    "sanity structure builder"
  ],
  "homepage": "https://sanity-structure-tool.nishargshah.dev",
  "bugs": {
    "url": "https://github.com/sanity-plugin/structure-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanity-plugin/structure-tool.git",
    "directory": "packages/sanity-plugin-structure-tool"
  },
  "license": "MIT",
  "author": "Nisharg Shah <nishargshah3101@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "sanity.json",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --check --log-level silent --ignore-path ../../.gitignore",
    "format:fix": "prettier . --write --log-level silent --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "script:lint": "bash -e ../../scripts/lint.sh --filter=sanity-plugin-structure-tool",
    "typecheck": "tsc --noEmit"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "pluralize-esm": "^9.0.5"
  },
  "devDependencies": {
    "@structure-tool/tsdown-config": "workspace:*",
    "@structure-tool/typescript-config": "workspace:*",
    "tsdown": "catalog:",
    "type-fest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "sanity": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": false
    },
    "sanity": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "inlinedDependencies": {
    "tagged-tag": "1.0.0",
    "type-fest": "5.7.0"
  }
}
