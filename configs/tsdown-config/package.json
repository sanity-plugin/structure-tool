{
  "name": "@structure-tool/tsdown-config",
  "version": "0.0.1",
  "private": true,
  "description": "@structure-tool/tsdown-config description",
  "author": "Nisharg Shah <nishargshah3101@gmail.com>",
  "type": "module",
  "exports": {
    "./base": "./dist/base.mjs",
    "./package": "./dist/package.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown --watch",
    "format": "prettier . --check --log-level silent --ignore-path ../../.gitignore",
    "format:fix": "prettier . --write --log-level silent --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "script:lint": "bash -e ../../scripts/lint.sh --filter=@structure-tool/tsdown-config",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@structure-tool/typescript-config": "workspace:*",
    "tsdown": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
