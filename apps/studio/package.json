{
  "name": "@structure-tool/studio",
  "version": "0.4.0",
  "private": true,
  "description": "Structure Builder Examples",
  "type": "module",
  "scripts": {
    "build": "sanity build",
    "dev": "sanity dev",
    "format": "prettier . --check --log-level silent --ignore-path ../../.gitignore",
    "format:fix": "prettier . --write --log-level silent --ignore-path ../../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "script:lint": "bash -e ../../scripts/lint.sh --filter=@structure-tool/studio",
    "start": "sanity start",
    "typecheck": "tsc --noEmit",
    "vercel:build": "pnpm --filter @structure-tool/project bootstrap && pnpm build"
  },
  "dependencies": {
    "@sanity/assist": "^6.1.3",
    "@sanity/icons": "^3.7.4",
    "@sanity/vision": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^6.1.0",
    "sanity-plugin-structure-tool": "workspace:*",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@structure-tool/typescript-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "type-fest": "catalog:",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
